# Source in every AR-image job: source /blue/qi855292.ucf/ji757406.ucf/MarkWeightX/exp/arimg/arimg.env
export B=/blue/qi855292.ucf/ji757406.ucf
export MWX_RUNS=/blue/sgao1/ji757406.ucf/mwx-runs   # outputs on the sgao1 disk (qi855292.ucf blue full, 2026-10-21)
export HF_HUB_OFFLINE=1                           # models are cached; nothing new goes to the qi855292.ucf disk
export WMAR=$B/wmar                           # facebookresearch/wmar, unchanged
export TAMING=$WMAR/checkpoints/2021-04-03T19-39-50_cin_transformer
unset TRANSFORMERS_CACHE
export HF_HOME=$B/hf_cache
export UV_CACHE_DIR=$B/uv_cache
if [ -f $B/venvs/wmar/bin/activate ]; then source $B/venvs/wmar/bin/activate; fi
