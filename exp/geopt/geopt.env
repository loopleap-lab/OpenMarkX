# Source in every GeoPT job: source /blue/qi855292.ucf/ji757406.ucf/MarkWeightX/exp/geopt/geopt.env
export B=/blue/qi855292.ucf/ji757406.ucf
export MWX_RUNS=$B/mwx-runs
export GEOPT=$B/GeoPT                      # the authors' code, unchanged (github.com/Physics-Scaling/GeoPT)
export GEOPT_DATA=$MWX_RUNS/geopt/aircraft_npys
unset TRANSFORMERS_CACHE
export HF_HOME=$B/hf_cache
export UV_CACHE_DIR=$B/uv_cache
# (an if, not "[ ] && source": under set -e a sourced file must not end on a failed test before the venv exists)
if [ -f $B/venvs/geopt/bin/activate ]; then source $B/venvs/geopt/bin/activate; fi
